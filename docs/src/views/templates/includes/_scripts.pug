block scripts
	- const highlighter = `${basePath}lib/highlight.min.js`
	- const lineNumbers = `${basePath}lib/highlightjs-line-numbers.min.js`

	if isProd
		script(src=`${basePath}assets/scripts/copybutton.js` vite-ignore defer)
		script(src=`${basePath}assets/scripts/anchorlink.js` vite-ignore defer)
		script(src=`${basePath}assets/scripts/install-wizard.js` vite-ignore defer)
		script(src=`${basePath}assets/scripts/main.js` vite-ignore defer data-highlighter=highlighter data-line-numbers=lineNumbers)
		script(src=`${basePath}assets/scripts/transforms.js` vite-ignore defer)
		script(src=`${basePath}lib/panelset.js` vite-ignore defer)
		script(src=`${basePath}lib/tablechart.js` vite-ignore defer)
		script(src=`${basePath}lib/tablechart-additional-types.js` vite-ignore defer)
		script(src=`${basePath}lib/tablechart-summary.js` vite-ignore defer)
		script.
			document.addEventListener('DOMContentLoaded', function () {
				Panel.init('.docs-sidebar [data-panel]', { returnFocus: false });
				PanelSet.init();
				PanelControl.init();
				Tablechart.Summary.init();
				Tablechart.init({ transforms: window.docsTransforms });
			});

	else
		script(type="module" src="/src/assets/scripts/copybutton.js")
		script(type="module" src="/src/assets/scripts/anchorlink.js")
		script(type="module" src="/src/assets/scripts/install-wizard.js")
		script(type="module" src="/src/assets/scripts/main.js" data-highlighter=highlighter data-line-numbers=lineNumbers)
		script(type="module" src="/src/assets/scripts/transforms.js")
		//- PanelSet for the sidebar and any tabs on a page, and Tablechart for the charts.
		script(type="module").
			import { Panel, PanelSet, PanelControl } from 'panelset';
			import { addType, create, init } from '@martinomagnifico/tablechart';
			import { candlestick, scatter } from '@martinomagnifico/tablechart/additional-types';
			import { Summary } from '@martinomagnifico/tablechart/summary';
			Panel.init('.docs-sidebar [data-panel]', { returnFocus: false });
			PanelSet.init();
			PanelControl.init();
			addType('scatter', scatter);
			addType('candlestick', candlestick);
			Summary.init();
			init({ debug: true, transforms: window.docsTransforms });
			// As in the build, where tablechart.js gives it: for a page that makes a chart later, such as the summary demo.
			window.Tablechart = { create };
