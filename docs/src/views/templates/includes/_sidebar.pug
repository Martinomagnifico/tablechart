aside.docs-sidebar
	header
		a.logo(href=url('/'))
			+logoicon
			| Tablechart

		button.nav-toggle(aria-controls="main-nav")
			span.sr-only Toggle navigation
			+burger(24)

	//- No data-panel-align: the drawer is anchored right and grows LEFTWARDS, so the growing edge is the left one, and that is align "start", the default. Pin the wrapper to the wrong edge and the content is wiped open instead of sliding in.
	#main-nav(data-panel data-panel-axis="horizontal" data-panel-static="(min-width: 769px)" data-panel-return-focus="true")
		.panel-wrapper
			nav(data-panel-group data-panel-close-siblings)
				//- One list, in order: a page of its own, or a group of pages. A line separates each entry from the one before it.
				each section, i in navItems
					if !section.title
						- let active = (section.text === pagetitle);
						a(class=[(active ? "active" : ""), (i > 0 ? "nav-sep" : "")].filter(Boolean).join(" ") href=url(section.href) tabindex=(active ? "-1" : false)) #{section.text}
						- continue
					- const sectionId = 'nav-' + section.title.toLowerCase().replace(/\s+/g, '-')
					- const allLinks = [...(section.links || []), ...(section.examples || []), ...(section.additional || []), ...(section.integrations || [])]
					- const isActive = allLinks.some(link => link.text === pagetitle)

					.nav-section(class=(i > 0 ? "nav-sep" : false))
						button.nav-section-toggle(class=isActive ? 'active' : '', aria-controls=sectionId, aria-expanded=String(isActive) )
							span= section.title
							+chevron(18, 'down')
						div(id=sectionId, data-panel, class=isActive ? 'is-open' : '')
							.panel-wrapper
								.section-links
									if section.linksLabel
										p.nav-examples-label= section.linksLabel
									ul
										each link in section.links
											- let active = (link.text === pagetitle);
											li
												a(class=(active ? "active" : "") href=url(link.href) tabindex=(active ? "-1" : false)) #{link.label || link.text}
									
									if section.examples
										p.nav-examples-label= section.examplesLabel || 'Examples'
										ul.nav-examples
											each link in section.examples
												- let active = (link.text === pagetitle);
												li
													a(class=(active ? "active" : "") href=url(link.href) tabindex=(active ? "-1" : false)) #{link.label || link.text}

									if section.additional
										p.nav-examples-label Additional types
										ul.nav-examples
											each link in section.additional
												- let active = (link.text === pagetitle);
												li
													a(class=(active ? "active" : "") href=url(link.href) tabindex=(active ? "-1" : false)) #{link.label || link.text}

									if section.integrations
										p.nav-examples-label Integrations
										ul.nav-examples
											each link in section.integrations
												- let active = (link.text === pagetitle);
												li
													a(class=(active ? "active" : "") href=url(link.href) tabindex=(active ? "-1" : false)) #{link.label || link.text}

			.sidebar-about-wrap
				a.sidebar-about(href=url('/about.html') class=(pagetitle === "About / Buy me a coffee" ? "active" : "")) 
					| About / #[+coffee()] Buy me a coffee
