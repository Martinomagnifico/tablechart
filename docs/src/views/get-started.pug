extends /views/templates/layouts/_base

append variables
	- pagetitle = "Get started"
	- pagedescription = "Install Tablechart, write the markup for a chart, and start it."

block content
	.lane
		.container
			.page-header
				h1 Get started
				p.lead Install Tablechart, write the markup and start it.

	+section("Install")
		+installWizard('Tablechart', 'init')

	+section("Additional types")
		p The column, bar, line, area, waterfall and donut charts are in the main script. If you use an additional type, such as the #[a(href=url('/types/scatter.html')) scatter chart], load it as well, before the charts are made.
		p If you use a build tool, import the type and add it with #[code addType()]:

		+codeblock('JS').
			import { addType, init } from '@martinomagnifico/tablechart';
			import { scatter } from '@martinomagnifico/tablechart/additional-types';
			import '@martinomagnifico/tablechart/style.css';

			addType('scatter', scatter);
			init();

		p If you use a script tag, load #[code tablechart-additional-types.js] after #[code tablechart.js]. It adds all the additional types.

		+codeblock('HTML').
			<link rel="stylesheet" href="tablechart.css">
			<script src="tablechart.js"></script>
			<script src="tablechart-additional-types.js"></script>
			<script>
				Tablechart.init();
			</script>

		p See #[a(href=url('/types/additional-types.html')) Additional types].

	+section("Markup")
		p A chart is a #[code figure] with #[code data-chart] and a table in it. Its #[code figcaption] is the title. The first cell of a row is the label, the second the value.

		.card
			.demo
				figure(data-chart="column")
					table
						tbody
							tr
								th Spring
								td 58
							tr
								th Summer
								td 72
							tr
								th Autumn
								td 70

			p.code-note See below how it is just a table.

			+codeblock('HTML', null, '2-8')
				figure(data-chart="column")
					table
						tbody
							tr
								th Spring
								td 58
							tr
								th Summer
								td 72
							tr
								th Autumn
								td 70

		p #[code data-chart] sets the chart type: #[code column], #[code bar], #[code line], #[code area], #[code waterfall] or #[code donut], or an #[a(href=url('/types/additional-types.html')) additional type] such as #[code scatter].

	+section("Start it")
		p Call #[code init()] once the page has loaded. It makes a chart of every figure with #[code data-chart].

		+codeblock('JS').
			import { init } from '@martinomagnifico/tablechart';
			import '@martinomagnifico/tablechart/style.css';

			init();

		p To change when a chart builds, pass options. See #[a(href=url('/reference/options.html')) Options].

		+codeblock('JS').
			init({
			  threshold: 0.5, // How much of a chart must be in view
			  replay: false   // Build again when it scrolls back into view
			});

	+section("Next")
		ul
			li #[a(href=url('/types/column.html')) Chart types]
			li #[a(href=url('/styling/index.html')) Styling]
