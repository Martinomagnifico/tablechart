extends /views/templates/layouts/_base

append variables
	- pagetitle = "Reference | Attributes"
	- pagedescription = "Every data attribute in Tablechart, on a chart, a row and an annotation."

block content
	.lane
		.container
			.page-header
				h1 Attributes
				p.lead Every data attribute on a chart, a row and an annotation.

	+section("On the figure")
		table
			thead
				tr
					th Attribute
					th Does
			tbody
				tr
					td: code data-chart
					td Makes the figure a chart: #[code column], #[code bar], #[code line], #[code area], #[code waterfall] or #[code donut], or #[code scatter] from the #[a(href=url('/types/additional-types.html')) additional types]
				tr
					td: code data-chart-src
					td Reads the data from a JSON file. See #[a(href=url('/data.html')) Data].
				tr
					td: code data-chart-stack
					td Puts the values of a row on top of each other, in a column, bar, line or area chart
				tr
					td: code data-chart-shape="step"
					td Makes each value flat across its row, in a line or area chart
				tr
					td: code data-chart-shape="smooth"
					td Makes a line or area chart a curve through every point. #[code data-chart-shape="straight"] makes it straight when the #[code shape] option is #[code "smooth"].
				tr
					td: code data-chart-animate="grow"
					td How the chart builds: #[code grow], each element from zero, or #[code sweep], in one movement. #[code false] shows the chart from the start, without animation. See #[a(href=url('/styling/animation.html')) Animation].
				tr
					td: code data-fragment
					td On the figure, every row is a step; on a row, a column header or an annotation, that one is. See #[a(href=url('/features/steps.html')) Step by step].
				tr
					td: code data-fragment-index
					td Rows with the same index arrive on the same step
				tr
					td: code data-chart-entrance="0.25"
					td How far an element around the chart that animates in is in before the chart builds, from #[code 0] to #[code 1]. See #[a(href=url('/features/animated-parents.html')) Animated parents].
				tr
					td: code data-chart-legend
					td Puts the names of the lines in a legend. #[code data-chart-legend="false"] turns it off.
				tr
					td: code data-chart-labels
					td Puts the numbers of a column chart #[code inside] or #[code outside] the columns
				tr
					td: code data-chart-aspect
					td Sets the height of the chart as a share of its width, such as #[code 0.5]
				tr
					td: code data-chart-tooltip="auto"
					td The tooltip of the chart: #[code auto] only when the chart does not show all its numbers, #[code false] never, #[code true] always.
				tr
					td: code data-chart-table="auto"
					td When the table is shown under the chart: #[code always], #[code print], #[code auto] (in print, when the chart does not show all its numbers) or #[code never]
				tr
					td: code data-chart-axis
					td Adds numbers along the value axis of a column, bar, line, area or waterfall chart. #[code data-chart-axis="false"] turns them off when the #[code axis] option is #[code true].
				tr
					td: code data-chart-grid
					td Adds a light line at each number of the value axis, or of both axes on a scatter chart. #[code data-chart-grid="false"] turns it off when the #[code grid] option is #[code true].
				tr
					td: code data-chart-scale="0 100"
					td Where the value axis starts and ends, or with three numbers or more, the numbers along it. On a scatter chart it is the axis up, and #[code data-chart-scale-y] is another name for it. See #[a(href=url('/styling/axes.html#the-scale')) The scale].
				tr
					td: code data-chart-scale-x="0 100"
					td The same, for the axis across
				tr
					td: code data-chart-names="false"
					td Turns off the names next to the markers of a scatter chart
				tr
					td: code data-chart-keys
					td Adds translation keys to the names, starting with its value. See #[a(href=url('/features/translation.html')) Translation].

	+section("On a row")
		table
			thead
				tr
					th Attribute
					th Does
			tbody
				tr
					td: code data-kind="total"
					td Makes the row a total, in a waterfall or a donut
				tr
					td: code class
					td Is copied to the bar, the number and the name of the row

	+section("On a column header")
		table
			thead
				tr
					th Attribute
					th Does
			tbody
				tr
					td: code data-kind="focus"
					td Highlights the line or the bars of this column. The others are shown fainter.
				tr
					td: code data-marker
					td Sets the point of the line: #[code circle], #[code square] or #[code diamond], with #[code open] for an open point
				tr
					td: code data-line
					td Makes the line #[code dashed] or #[code dotted]
				tr
					td: code data-group
					td On a scatter chart: the cells of this column name the groups. Each group has its own colour and shape. See #[a(href=url('/types/scatter.html#groups')) Scatter].

	+section("On an annotation")
		p Each annotation is a #[code span] with #[code data-annotation], in a #[code div] with the class #[code chart-annotations]. See #[a(href=url('/features/annotations.html')) Annotations].

		table
			thead
				tr
					th Annotation
					th Attribute
					th Sets
			tbody
				tr
					td: code bracket
					td: code data-from, data-to
					td The rows the bracket runs between. The first row is #[code 1].
				tr
					td: code trend
					td: code data-at
					td Where the badge is along the arrow, from #[code 0] to #[code 1]
				tr
					td: code trend
					td: code data-years
					td The number of years, to check the yearly rate you wrote
				tr
					td: code axis-break
					td: code data-from, data-to
					td The part of the scale that is made smaller
				tr
					td: code axis-break
					td: code data-size
					td The share of the height that part gets, as a percentage
				tr
					td: code axis-break
					td: code data-mark
					td How the break is shown: two slanted lines by default, or #[code zigzag]. See #[a(href=url('/features/scale-break.html')) Scale break].
				tr
					td: code reference
					td: code data-value
					td A line at a value on the value axis: a number, #[code mean] or #[code median] of the values
				tr
					td: code reference
					td: code data-name
					td A line among names that are numbers: a number, #[code mean] or #[code median], with each name counted as often as its value
				tr
					td: code reference
					td: code data-line
					td #[code dotted] makes the line dotted. It is dashed by default.
				tr
					td All
					td: code data-series
					td The line the annotation uses, on a chart with several lines. The first line is #[code 1].

	+section("Set by Tablechart")
		p Tablechart adds these attributes. You can use them in CSS.

		table
			thead
				tr
					th Attribute
					th On
					th Says
			tbody
				tr
					td: code data-row
					td Bars, numbers
					td The row, counted from 1
				tr
					td: code data-series
					td Lines, points, bars, numbers, names
					td The value column, counted from 1
				tr
					td: code data-slice
					td Donut slices
					td The slice, counted from 1
				tr
					td: code data-marker, data-open
					td Points
					td The shape of the point, and if it is open
				tr
					td: code data-left-out
					td Numbers
					td The number is left out for lack of room

	+section("Next")
		p For the options of #[code init()], see #[a(href=url('/reference/options.html')) Options].
