extends /views/templates/layouts/_base

append variables
	- pagetitle = "Reference | API"
	- pagedescription = "Tablechart's API: init(), create(), addType() and what they return."

block content
	.lane
		.container
			.page-header
				h1 API
				p.lead init(), create(), addType() and what they return.

	+section("init()")
		p #[code init()] makes a chart of every figure that matches #[code selector], and builds each chart when it scrolls into view. It returns a promise.

		+codeblock('JS').
			import { init } from "@martinomagnifico/tablechart";
			import "@martinomagnifico/tablechart/style.css";

			const tablechart = await init(options, root);

		table
			thead
				tr
					th Argument
					th Is
			tbody
				tr
					td: code options
					td The #[a(href=url('/reference/options.html')) options]. Optional.
				tr
					td: code root
					td The element to look for charts in. #[code document] by default.

		p If you call #[code init()] again, it skips the figures that are already charts. If you want to make charts of figures that are added to the page later, call it again with the element that holds them as #[code root], or use #[code create()].

	+section("What it returns")
		table
			thead
				tr
					th Property
					th Is
			tbody
				tr
					td: code charts
					td A list of the charts it made. See #[a(href="#one-chart") One chart].
				tr
					td: code refresh()
					td Lays out every chart again, for example after a script has changed the text of a chart
				tr
					td: code destroy()
					td Stops watching scroll, size and language. The charts stay as they are.

	+section("create()")
		p #[code create()] makes a chart of one figure, and builds it when it scrolls into view. It returns a promise with the chart, or #[code null] if the figure has no data to draw. If the figure is already a chart, it returns that chart.

		+codeblock('JS').
			import { create } from "@martinomagnifico/tablechart";

			const chart = await create(document.querySelector("#sales"), {
				threshold: 0.3
			});

		p The options are the same as for #[code init()]. #[code selector] is not used.

	+section("addType()")
		p #[code addType()] adds one of the additional types. The first argument is the value of #[code data-chart], the second the type. It needs to come before #[code init()] or #[code create()]. A type can bring annotations of its own: adding #[code scatter] also adds #[code quadrant]. See #[a(href=url('/types/additional-types.html')) Additional types].

		+codeblock('JS').
			import { addType, init } from "@martinomagnifico/tablechart";
			import { scatter } from "@martinomagnifico/tablechart/additional-types";

			addType("scatter", scatter);
			init();

		p With a script tag it is #[code Tablechart.addType()]. #[code tablechart-additional-types.js] calls it by itself.

	+section("One chart")
		p Each chart that #[code init()] or #[code create()] makes is also on its element, as #[code tablechart].

		+codeblock('JS').
			document.querySelector("#sales").tablechart.refresh();

		table
			thead
				tr
					th Property
					th Is
			tbody
				tr
					td: code figure
					td The figure of the chart
				tr
					td: code refresh()
					td Lays the chart out again
				tr
					td: code destroy()
					td Stops watching scroll, size and language for this chart. The chart stays as it is, and #[code tablechart] is removed from the element.
				tr
					td: code next()
					td On a chart that steps: shows one step more. See #[a(href=url('/features/steps.html')) Step by step].
				tr
					td: code previous()
					td On a chart that steps: shows one step less
				tr
					td: code stepTo(step)
					td On a chart that steps: shows it up to #[code step], from #[code 0] to #[code steps]
				tr
					td: code step
					td How many steps are shown
				tr
					td: code steps
					td How many steps the chart has: #[code 0] for a chart that does not step

		p A chart that steps sends a #[code tablechart:step] event from its figure at each step, with #[code step] and #[code steps] in #[code event.detail].

	+section("Building blocks")
		p For a script or a plugin that decides itself when a chart is built and shown, #[code @martinomagnifico/tablechart/core] has the steps that #[code init()] and #[code create()] take.

		+codeblock('JS').
			import { prepare, build, layout, setShown, defaultConfig } from "@martinomagnifico/tablechart/core";

			const config = { ...defaultConfig };
			const [figure] = await prepare([element], config);
			const chart = build(figure, config);

			// Once the chart has a width:
			layout(chart, config);
			setShown(chart, true);

		table
			thead
				tr
					th Function
					th Does
			tbody
				tr
					td: code prepare()
					td Turns elements into figures with a table: a table from Markdown, or the data of a JSON file. Adds translation keys.
				tr
					td: code build()
					td Makes everything in the chart, with its text. It needs no width.
				tr
					td: code layout()
					td Places everything. It needs to run again when the width changes.
				tr
					td: code setShown()
					td Starts the animation, or shows the chart whole.
				tr
					td: code relabel()
					td Formats the numbers again, for example after a language change.
				tr
					td: code unbuild()
					td Removes what #[code build()] made, so the chart can be built again.
				tr
					td: code stepTo()
					td Shows a chart that steps up to a step. A presentation plugin calls it for its own steps, with #[code controls] set to #[code false].

		p #[code build()] also gives the chart its tooltip, as the #[code tooltip] option says. #[code unbuild()] closes it.
		p #[code init()] and #[code create()] get every chart ready for print. With the building blocks, do that yourself before the page prints: add #[code PRINTING_CLASS] to the figure, so the chart has no transitions, and show it. After printing, the class can go again.

		+codeblock('JS').
			import { setShown, PRINTING_CLASS } from "@martinomagnifico/tablechart/core";

			window.addEventListener("beforeprint", () => {
				chart.figure.classList.add(PRINTING_CLASS);
				setShown(chart, true);
			});
			window.addEventListener("afterprint", () => chart.figure.classList.remove(PRINTING_CLASS));

	+section("With a script tag")
		p Without a build tool, load #[code tablechart.js] and #[code tablechart.css]. #[code Tablechart.init()] and #[code Tablechart.create()] work the same as #[code init()] and #[code create()].

		+codeblock('HTML').
			<link rel="stylesheet" href="tablechart.css">
			<script src="tablechart.js"></script>
			<script>
				Tablechart.init();
			</script>

	+section("Summary")
		p The summary is a separate import. See #[a(href=url('/features/summary.html')) Summary].

		+codeblock('JS').
			import { Summary } from "@martinomagnifico/tablechart/summary";

			Summary.init({ delimiters: ["{", "}"] });

		table
			thead
				tr
					th Function
					th Does
			tbody
				tr
					td: code Summary.init(options)
					td Fills the summary of every chart, and again when its table is ready or changes, and when a translation changes a sentence or the language of the page
				tr
					td: code Summary.fill(figure)
					td Fills the summary of one chart again, from its table as it is now

		table
			thead
				tr
					th Option
					th Default
					th Sets
			tbody
				tr
					td: code selector
					td: code "[data-chart]:not(th)"
					td The charts that can have a summary
				tr
					td: code delimiters
					td: code ["{", "}"]
					td The characters around a placeholder
				tr
					td: code langattribute
					td: code "data-i18n"
					td The attribute for translation keys. A name in a sentence keeps its key.
				tr
					td: code locale
					td The language of the page
					td The locale for numbers and lists
				tr
					td: code flat
					td: code 5
					td A change or a trend of less than this percentage is #[code flat]
				tr
					td: code outliers
					td: code 25
					td A value more than this percentage away from the trend is an outlier
				tr
					td: code words
					td: code { up: "up", … }
					td The words for #[code {trend}], #[code {change}] and #[code {side}]: #[code up], #[code down], #[code flat], #[code unclear], #[code above] and #[code below]

		p With a script tag, #[code tablechart-summary.js] adds #[code Tablechart.Summary].

	+section("Defaults")
		p #[code defaultConfig] holds the default options.

		+codeblock('JS').
			import { defaultConfig } from "@martinomagnifico/tablechart";

	+section("TypeScript")
		p #[code TablechartConfig] describes the options, #[code TablechartInstance] what #[code init()] returns, and #[code TablechartChart] one chart.

		+codeblock('JS').
			import type { TablechartConfig, TablechartInstance, TablechartChart } from "@martinomagnifico/tablechart";
