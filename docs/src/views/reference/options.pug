extends /views/templates/layouts/_base

append variables
	- pagetitle = "Reference | Options"
	- pagedescription = "Every option that Tablechart's init() takes, with its default."

block content
	.lane
		.container
			.page-header
				h1 Options
				p.lead Everything init() takes.

	+section("Set options")
		p Pass the options to #[code init()]. Options that you leave out keep their default.

		+codeblock('JS').
			init({
				threshold: 0.3,
				legend: true
			});

	+section("All options")
		table
			thead
				tr
					th Option
					th Default
					th Sets
			tbody
				tr
					td: code selector
					td: code "[data-chart]"
					td The elements that become charts
				tr
					td: code aspect
					td: code 0.38
					td The height of a chart as a share of its width. #[code data-chart-aspect] on a figure sets it for one chart.
				tr
					td: code barfill
					td: code 0.58
					td The share of its row that a bar takes, up to #[code --tablechart-bar-max]
				tr
					td: code ringfill
					td: code 0.42
					td The share of the radius of a donut that the ring takes
				tr
					td: code animate
					td: code true
					td How a chart builds. #[code false] shows it whole, without animation. #[code "up"] makes lines and areas grow up from zero, instead of from left to right. #[code data-chart-animate] on a figure sets it for one chart.
				tr
					td: code entrance
					td: code 0.5
					td How far an element that animates in is in before its chart builds: #[code 0] when it starts moving, #[code 1] when it is in. #[code data-chart-entrance] on a figure sets it for one chart.
				tr
					td: code labels
					td: code "outside"
					td Where the number of a column goes: #[code "outside"], above the column, or #[code "inside"]. #[code data-chart-labels] on a figure sets it for one chart.
				tr
					td: code closing
					td: code "down"
					td How the last total of a waterfall grows: #[code "down"], from the step before it to the baseline, or #[code "up"], from the baseline. #[code data-chart-closing] on a figure sets it for one chart.
				tr
					td: code shape
					td: code "straight"
					td How a line or area chart runs from one point to the next: #[code "straight"], #[code "step"] or #[code "smooth"]. #[code data-chart-shape] on a figure sets it for one chart.
				tr
					td: code legend
					td: code false
					td If #[code true], the names of the lines are in a legend under the chart. #[code data-chart-legend] on a figure sets it for one chart.
				tr
					td: code hover
					td: code true
					td If a number is left out for lack of room, pointing at its row shows it. #[code data-chart-hover="false"] on a figure turns it off for one chart.
				tr
					td: code totallabel
					td: code "Total"
					td The name of the total of a donut without a total row, for screen readers
				tr
					td: code controls
					td: code true
					td Previous and Next buttons under a chart that steps. #[code false] leaves them out. See #[a(href=url('/features/steps.html')) Step by step].
				tr
					td: code previouslabel
					td: code "Previous"
					td The text of the Previous button
				tr
					td: code nextlabel
					td: code "Next"
					td The text of the Next button
				tr
					td: code stephint
					td: code "step of the chart"
					td Text for screen readers after the text of each button, so they hear "Next step of the chart"
				tr
					td: code threshold
					td: code 0.5
					td How much of a chart must be in view before it builds, from #[code 0] to #[code 1]
				tr
					td: code replay
					td: code false
					td If #[code true], a chart builds again each time it scrolls back into view
				tr
					td: code locale
					td Not set
					td The language for numbers, such as #[code "nl"]. If not set, the #[code lang] attribute of the page is used.
				tr
					td: code langattribute
					td: code "data-i18n"
					td The attribute for translation keys. #[code false] adds no translation keys.
				tr
					td: code debug
					td: code false
					td If #[code true], Tablechart shows messages in the console, with how long each chart takes to build and to lay out. A chart that takes more than 50 ms gets a warning.

	+section("Next")
		p For the attributes on a chart, see #[a(href=url('/reference/attributes.html')) Attributes]. For what #[code init()] returns, see #[a(href=url('/reference/api.html')) API].
