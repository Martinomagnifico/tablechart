extends /views/templates/layouts/_base

append variables
	- pagetitle = "Styling | Colours"
	- pagedescription = "Colours in Tablechart: one colour for all bars, colours for a waterfall, and a palette."

block content
	.lane
		.container
			.page-header
				h1 Colours
				p.lead One colour for all bars, colours for a waterfall, and a palette.

	+section("One colour")
		p #[code --tablechart-bar-color] sets the colour of all bars, and of a single line.

		+style.
			.orange {
				--tablechart-bar-color: #e4572e;
			}

		+chart(null, '1')
			figure.orange(data-chart="column")
				table
					tbody
						each row in [['Spring', '58'], ['Summer', '72'], ['Autumn', '70'], ['Winter', '91']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]

	+section("Waterfall colours")
		p These set the colours of rising steps, falling steps and totals. The number inside a bar gets a colour with enough contrast with the bar. See #[a(href=url('/styling/text.html#numbers-inside-bars-or-columns')) Numbers inside bars or columns].

		+style.
			.warm {
				--tablechart-up-color: #b4552d;
				--tablechart-down-color: #d69a52;
				--tablechart-total-color: #cfc4b4;
			}

		+chart(null, '1')
			figure.warm(data-chart="waterfall")
				table
					tbody
						each row in [['Picked', '74.5', 'total'], ['Windfalls', '28.2'], ['Bruised', '-16.1'], ['Peelings', '-13.3'], ['Pressed', '73.3', 'total']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]

	+section("A palette")
		p Donut slices use #[code --tablechart-color-1], #[code --tablechart-color-2] and on, in order. If a colour is not set, that slice uses the default.

		+style.
			.fruity {
				--tablechart-color-1: #b4552d;
				--tablechart-color-2: #d69a52;
				--tablechart-color-3: #7fa87f;
				--tablechart-color-4: #cfc4b4;
			}

		+chart(null, '1')
			figure.fruity(data-chart="donut")
				table
					tbody
						each row in [['Picked', '74.5', 'total'], ['Juiced', '38.2'], ['Eaten fresh', '18.1'], ['Sold whole', '12.4'], ['Composted', '5.8']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]

		p If a line chart has several lines, the lines use the palette too.

		+chart(null, '1')
			figure.fruity(data-chart="line")
				table
					thead
						tr
							th Year
							th North
							th South
							th East
					tbody
						each row in [['2016', '41', '30', '22'], ['2019', '58', '39', '35'], ['2022', '77', '52', '41'], ['2025', '105', '61', '70']]
							tr
								th= row[0]
								td= row[1]
								td= row[2]
								td= row[3]

	+section("Without a palette")
		p Without a palette, each slice or line is a bit lighter than the one before it. These variables set how much.

		table
			thead
				tr
					th Variable
					th Sets
			tbody
				tr
					td: code --tablechart-slice-color
					td The colour of the first slice. The text colour by default.
				tr
					td: code --tablechart-slice-fade
					td How much lighter each slice is: 15% by default.
				tr
					td: code --tablechart-slice-min
					td The lightest a slice gets: 20% of its colour by default.
				tr
					td: code --tablechart-series-color
					td The colour of the first line. The bar colour by default.
				tr
					td: code --tablechart-series-fade
					td How much lighter each line is: 30% by default. With more than three lines, the steps are smaller, so the last line is not lighter than #[code --tablechart-series-min].
				tr
					td: code --tablechart-series-min
					td The lightest a line gets: 40% of its colour by default.
				tr
					td: code --tablechart-series-muted-share
					td The strength of a line next to a highlighted line: 45% by default.
				tr
					td: code --tablechart-series-own-color
					td The colour of one line, set on [data-series="2"] and so on.

	+section("A range of colours")
		p If you set an end colour, the lines, the parts of a stack or the slices go from the first colour to the end colour, in even steps, instead of getting lighter. With two lines they are the first and the end colour; with three there is also the colour exactly in between, and so on.
		p If both colours have a contrast of at least 3:1 with the background, and both are darker than the background, or both lighter, every colour in between has that too. If both have at least 4.5:1, the numbers inside the parts can stay in the background colour.

		+style.
			.dark-range {
				--tablechart-bar-color: #0b5d66;
				--tablechart-series-color-end: #1f3a8a;
			}

		+chart(null, '1')
			figure.dark-range(data-chart="column" data-chart-stack)
				figcaption
					b Apples sold
					br
					span thousands
				table
					thead
						tr
							th Year
							th Farm shop
							th Market
							th Online
					tbody
						each row in [['2023', '64', '38', '22'], ['2024', '71', '45', '30'], ['2025', '69', '57', '26'], ['2026', '80', '62', '41']]
							tr
								th= row[0]
								td= row[1]
								td= row[2]
								td= row[3]

		table
			thead
				tr
					th Variable
					th Sets
			tbody
				tr
					td: code --tablechart-series-color-end
					td The colour of the last line or part. The first is #[code --tablechart-series-color], or the bar colour. #[code --tablechart-series-color-start] is another name for the first colour, to go with the end colour.
				tr
					td: code --tablechart-slice-color-end
					td The colour of the last slice. The first is #[code --tablechart-slice-color]. #[code --tablechart-slice-color-start] is another name for it, to go with the end colour.
