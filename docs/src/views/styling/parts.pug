extends /views/templates/layouts/_base

append variables
	- pagetitle = "Styling | Parts of a chart"
	- pagedescription = "Styling lines and points, the baseline, waterfall connectors, badges, bar width and rounded ends in Tablechart."

block content
	.lane
		.container
			.page-header
				h1 Parts of a chart
				p.lead Lines and points, the baseline, connectors, the badge, the bar width and rounded ends and slices.

	+section("Lines and points")
		p These variables set the lines of a line chart or an area chart, and their points. The colours of the lines are on #[a(href=url('/styling/colours.html')) Colours]. Which line has which point and pattern is on #[a(href=url('/types/line.html#points')) Line].

		+style.
			.bold-lines {
				--tablechart-series-width: 3px;
				--tablechart-series-dash: 10 6;
				--tablechart-series-dash-dot: 10 6 0 6;
				--tablechart-point-color: light-dark(#c8500a, #ffb366);
			}

		+chart(null, '1')
			figure.bold-lines(data-chart="line" data-chart-legend)
				figcaption: b Apples per tree
				table
					thead
						tr
							th Year
							th North
							th(data-line="dashed") South
							th(data-line="dash-dot") East
					tbody
						each row in [['2016', '41', '30', '22'], ['2019', '58', '39', '35'], ['2022', '77', '52', '41'], ['2025', '105', '61', '70']]
							tr
								th= row[0]
								td= row[1]
								td= row[2]
								td= row[3]

		table
			thead
				tr
					th Variable
					th Sets
			tbody
				tr
					td: code --tablechart-series-width
					td The width of a line: 2px by default
				tr
					td: code --tablechart-series-dash
					td The pattern of a dashed line, in pixels: #[code 6 4] by default
				tr
					td: code --tablechart-series-dot
					td The pattern of a dotted line, in pixels: #[code 0 4] by default
				tr
					td: code --tablechart-series-dash-dot
					td The pattern of a dash-dot line, in pixels: #[code 6 4 0 4] by default
				tr
					td: code --tablechart-point-color
					td The points on a line, also in the legend and the tooltip: the colour of the line by default
				tr
					td #[code --tablechart-area-color] / #[code -opacity] / #[code -fade]
					td The fill under a line, in an area chart

	+section("Baseline and connectors")
		p The baseline and the connectors between waterfall steps each have a colour, width and opacity. #[code --tablechart-connector-dash] sets the dashes.

		+style.
			.dotty {
				--tablechart-connector-width: 2.5px;
				--tablechart-connector-dash: 0 6;
				--tablechart-connector-opacity: 1;
				--tablechart-baseline-width: 2px;
				--tablechart-baseline-opacity: 1;
			}
			/* A dash of 0 with round ends is a dot. */
			.dotty .tablechart-connector {
				stroke-linecap: round;
			}

		+chart(null, '1')
			figure.dotty(data-chart="waterfall")
				table
					tbody
						each row in [['Picked', '74.5', 'total'], ['Windfalls', '28.2'], ['Bruised', '-16.1'], ['Peelings', '-13.3'], ['Pressed', '73.3', 'total']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]

	+section("Badges")
		p The badge of an annotation, such as a bracket, a trend arrow or a note, is a box with rounded corners by default. These variables set its corners, padding and background. For an ellipse, set the corners to #[code 50%], with more padding at the sides, so the text stays clear of the curve:

		+style.
			.ellipse {
				--tablechart-badge-radius: 50%;
				--tablechart-badge-padding: 0.5em 1.25em;
			}

		+chart(null, '1')
			figure.ellipse(data-chart="column")
				table
					tbody
						each row in [['Last season', '251.5'], ['This season', '279.6']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]
				.chart-annotations
					span(data-annotation="bracket") +11%

	+section("Bar width")
		p A bar is never wider than #[code --tablechart-bar-max]: #[code 60px] by default. It can be in #[code px], #[code %] of the chart width, #[code em] or #[code rem], or #[code none] for no maximum.

		+chart(null, '1')
			figure(data-chart="column" style="--tablechart-bar-max: 24px")
				table
					tbody
						each row in [['Spring', '58'], ['Summer', '72'], ['Autumn', '70'], ['Winter', '91']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]

	+section("Height")
		p A chart gets higher with its width. If you want it to stop at a certain height, set #[code --tablechart-max-height]. Above that height, the chart only gets wider. If you want one height at every width, such as in a dashboard tile, set #[code --tablechart-height]. Both can be in #[code px], #[code em] or #[code rem].

		p If the rows of a bar chart need more room than the maximum, the chart gets that room.

		p The height is the width times #[code data-chart-aspect], between the minimum and the maximum. So these three values set the shape of a chart at every width. In this example, a chart narrower than 320px is taller than it is wide. Between 320px and 480px it is square. Wider than 480px, it is wider than it is high, and it does not get higher.

		+chart(null, '1')
			figure(data-chart="column" data-chart-aspect="1" style="--tablechart-min-height: 320px; --tablechart-max-height: 480px")
				table
					tbody
						each row in [['Spring', '58'], ['Summer', '72'], ['Autumn', '70'], ['Winter', '91']]
							tr
								th= row[0]
								td= row[1]

		+chart(null, '1')
			figure(data-chart="column" style="--tablechart-max-height: 240px")
				table
					tbody
						each row in [['Spring', '58'], ['Summer', '72'], ['Autumn', '70'], ['Winter', '91']]
							tr
								th= row[0]
								td= row[1]

	+section("Charts side by side")
		p If the names under one chart take two lines and those under the chart next to it take one, the baselines of the charts do not line up. If you want them to line up, add #[code data-chart-group] to an element around the charts. Charts on one line of the page then get a row of names of the same height. Charts on another line have their own height, so this also works in a grid that wraps.

		p If the charts are in different places, add #[code data-chart-group="sales"] to each, with the same name.

		.card
			.demo
				div(data-chart-group style="display: grid; grid-template-columns: repeat(auto-fit, minmax(14em, 1fr)); gap: 1.5rem")
					figure(data-chart="column")
						table
							tbody
								each row in [['Elstar from the orchard', '58'], ['Jonagold from the hill', '72'], ['Cox from the old trees', '70']]
									tr
										th= row[0]
										td= row[1]
					figure(data-chart="column")
						table
							tbody
								each row in [['2024', '41'], ['2025', '52']]
									tr
										th= row[0]
										td= row[1]

		p If the numbers of the charts can be compared, also add #[code data-chart-group-scale]. All charts of the group then use one scale, from the lowest to the highest value of them all. Charts on one line of the page also get the same plot height, so the same value is the same height. If the units of the charts differ, such as euros and percentages, leave it out. A waterfall chart and a chart with a break in its scale keep their own scale.

		.card
			.demo
				div(data-chart-group data-chart-group-scale style="display: grid; grid-template-columns: repeat(auto-fit, minmax(14em, 1fr)); gap: 1.5rem")
					figure(data-chart="column")
						figcaption: b Elstar
						table
							tbody
								each row in [['2023', '58'], ['2024', '72'], ['2025', '70']]
									tr
										th= row[0]
										td= row[1]
					figure(data-chart="column")
						figcaption: b Cox
						table
							tbody
								each row in [['2024', '41'], ['2025', '52']]
									tr
										th= row[0]
										td= row[1]

	+section("Rounded ends")
		p #[code --tablechart-corner-radius] rounds the corners of columns, bars and donut slices, in #[code px] or #[code em]. If one of them needs another value, #[code --tablechart-bar-radius] sets it for columns and bars, and #[code --tablechart-slice-radius] for slices.

		p On a column or bar, the end that shows the value gets rounded. The end at the baseline stays square. In a stack, only the outer end of the stack is rounded. A column shorter than the radius gets a smaller radius. A waterfall stays square.

		+chart(null, '1')
			figure(data-chart="column" style="--tablechart-corner-radius: 6px")
				table
					tbody
						each row in [['Spring', '58'], ['Summer', '72'], ['Autumn', '70'], ['Winter', '91']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]

	+section("Rounded slices")
		p #[code --tablechart-corner-radius] also rounds the corners of the slices of a donut. A thin slice gets a smaller radius.

		+chart(null, '1')
			figure(data-chart="donut" style="--tablechart-corner-radius: 6px")
				table
					tbody
						each row in [['Elstar', '42'], ['Jonagold', '28'], ['Gala', '18'], ['Cox', '12']]
							tr
								th= row[0]
								td= row[1]

	+section("All variables")
		table
			thead
				tr
					th Variable
					th Sets
			tbody
				tr
					td #[code --tablechart-baseline-color] / #[code -width] / #[code -opacity]
					td The baseline
				tr
					td #[code --tablechart-connector-color] / #[code -width] / #[code -dash] / #[code -opacity]
					td The connectors between waterfall steps
				tr
					td #[code --tablechart-leader-color] / #[code -width] / #[code -opacity]
					td The line from a donut slice to its number
				tr
					td #[code --tablechart-annotation-color] / #[code -width]
					td The lines and arrowheads of annotations
				tr
					td #[code --tablechart-break-color] / #[code -width] / #[code -opacity]
					td The lines of a break in the scale
				tr
					td #[code --tablechart-badge-surface] / #[code -padding] / #[code -radius] / #[code -border-width]
					td The badge
				tr
					td: code --tablechart-slice-gap
					td The gap between donut slices, in the units of the plot: 4 by default
				tr
					td: code --tablechart-bar-max
					td The widest a bar may be: 60px by default
				tr
					td: code --tablechart-max-height
					td The most height of a chart: none by default
				tr
					td: code --tablechart-height
					td A fixed height, for the minimum and the maximum at once
				tr
					td: code --tablechart-corner-radius
					td How round the corners of columns, bars and slices are: 0 by default
				tr
					td: code --tablechart-bar-radius
					td The same, for columns and bars only
				tr
					td: code --tablechart-slice-radius
					td The same, for slices only
