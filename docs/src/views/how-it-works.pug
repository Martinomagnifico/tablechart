extends /views/templates/layouts/_base

append variables
	- pagetitle = "How it works"
	- pagedescription = "How Tablechart turns a table into a chart, and when the chart builds."

block content
	.lane
		.container
			.page-header
				h1 How it works
				p.lead How a table becomes a chart, and when the chart builds.

	+section("From table to chart")
		p #[span.when-beside On the left]#[span.when-stacked At the top] is a table. #[span.when-beside On the right]#[span.when-stacked Under it] is the chart that Tablechart makes from that same table. 


		.grid-2
			div
				.card
					.demo
						table
							caption Apples picked
							tbody
								each row in [['Spring', '58'], ['Summer', '72'], ['Autumn', '70'], ['Winter', '41']]
									tr
										th= row[0]
										td= row[1]
			div
				.card
					.demo
						figure(data-chart="column")
							figcaption: b Apples picked
							table
								tbody
									each row in [['Spring', '58'], ['Summer', '72'], ['Autumn', '70'], ['Winter', '41']]
										tr
											th= row[0]
											td= row[1]

		ol
			li You call #[code init()]. Tablechart finds every #[code figure] with #[code data-chart].
			li It reads the table in it. The first cell of a row is the name, the other cells are the values.
			li It hides the table from view and adds the chart. Screen readers still read the table, and a translation script still finds the names in it.
			li When the chart scrolls into view, it builds.

	+section("Animation")
		p By default, a chart builds with an animation when it scrolls into view: when half of the chart is in view. If you want to change how much must be in view, set #[code threshold], from #[code 0] to #[code 1].
		p If #[code replay] is #[code true], a chart builds again each time it scrolls back into view. If not, it builds once.

		+codeblock('JS').
			init({
			  threshold: 0.5,
			  replay: false
			});

		.card

			.demo
				figure#build-demo(data-chart="column")
					table
						tbody
							each row in [['Jan', '41'], ['Feb', '38'], ['Mar', '52'], ['Apr', '61'], ['May', '74'], ['Jun', '88'], ['Jul', '93'], ['Aug', '90']]
								tr
									th= row[0]
									td= row[1]
			.demo-actions(style="margin-bottom: 0")
				button.btn.solid.build-again(type="button") Build again

		script.
			document.querySelector('.build-again').addEventListener('click', function () {
				document.getElementById('build-demo').tablechart.replay();
			});

		p If you want a chart on the page from the start, without animation, add #[code data-chart-animate="false"] to the figure. The chart is then shown as soon as the page is ready, also when it is not in view.

		+codeblock('HTML').
			<figure data-chart="column" data-chart-animate="false">

		p If you want to do this for every chart, set the #[code animate] option to #[code false]. See #[a(href=url('/styling/animation.html#no-animation')) No animation].

		+codeblock('JS').
			init({ animate: false });

	+section("Inside an animated container")
		p If a chart is inside an element that animates in, for example with a CSS animation, the chart builds when that animation is halfway. Then the chart builds in a container that can already be seen. See #[a(href=url('/features/animated-parents.html')) Animated parents].

	+section("Text")
		p All text in a chart is HTML: the title, the names and the numbers. It uses the font of the page. Only the bars, lines and slices are SVG.
		p If you zoom in on this page, you can see it. The numbers and names stay sharp, and keep the size of the text around them.

	+section("Size")
		p A chart fills the width of its container. Its height is a share of its width, set with #[code data-chart-aspect], but never less than #[code --tablechart-min-height], 200px by default, and never more than #[code --tablechart-max-height], if that is set. If the width changes, the chart is laid out again.
		p In this example the aspect is #[code 1], the minimum is #[code(data-clamp="min") 200px] and the maximum is #[code(data-clamp="max") 250px]. If you move the slider, the width of the chart changes, and the text under it says what happens to the height.

		.card.clamp-demo
			.playground-row
				label(for="clamp-width") Width
				input#clamp-width(type="range" min="130" max="640" step="5" value="640")
				output#clamp-value(for="clamp-width")
			.demo
				.size-box
					figure(data-chart="column" data-chart-aspect="1" style="--tablechart-min-height: 200px; --tablechart-max-height: 250px")
						table
							tbody
								each row in [['Jan', '41'], ['Feb', '52'], ['Mar', '74'], ['Apr', '88']]
									tr
										th= row[0]
										td= row[1]
			.clamp-zones
				div(data-zone="min")
					b Taller than wide
					span Under #[span(data-clamp="min") 200px] wide: the height stays at the minimum.
				div(data-zone="aspect")
					b Square
					span From #[span(data-clamp="min") 200px] to #[span(data-clamp="max") 250px] wide: the height follows the width.
				div(data-zone="max")
					b Wider than high
					span Over #[span(data-clamp="max") 250px] wide: the height stays at the maximum.
			p.clamp-note(aria-live="polite")


	+section("Reduced motion and print")
		p If the visitor prefers reduced motion, charts build without animation. When the page is printed, every chart is shown whole, also a chart that has not scrolled into view yet.

		.demo-actions
			button.btn.solid(type="button" onclick="window.print()") Print this page

	+section("Accessibility")
		p Screen readers read the table, not the drawing. See #[a(href=url('/accessibility.html')) Accessibility].

	+section("Next")
		p See #[a(href=url('/get-started.html')) Get started] to add Tablechart to your page.

	hr
	section.no-hr
		.container
			+anchor(title="Support this project")
			p Tablechart is free. If it saved you time, a coffee goes a long way.

			a.btn.solid.chevron(href="https://ko-fi.com/martinomagnifico" target="_blank" rel="noopener")
				+coffee()
				| Support my work on Ko-fi
				+chevron()



