extends /views/templates/layouts/_base

append variables
	- pagetitle = "Chart types | Area"
	- pagedescription = "Area charts in Tablechart: a line chart with the space under the line filled."

block content
	.lane
		.container
			.page-header
				h1 Area
				p.lead A line chart with the space under the line filled.

	+section("Area chart")
		p Each row of the table is a point. The space between the line and zero is filled. The number is shown above each point.

		+chart
			figure(data-chart="area")
				figcaption
					b Visitors to the orchard
					br
					span thousands
				table
					tbody
						each row in [['2021', '12'], ['2022', '18'], ['2023', '15'], ['2024', '24'], ['2025', '29']]
							tr
								th= row[0]
								td= row[1]

	+section("Smooth")
		p Add #[code data-chart-shape="smooth"] to the figure. The top of each area is a curve through every point, which never goes higher or lower than the points on either side of it. In a stack, each area follows the curve of the one below it.

		+chart(null, '1')
			figure(data-chart="area" data-chart-shape="smooth")
				figcaption
					b Visitors to the orchard
					br
					span thousands
				table
					tbody
						each row in [['2021', '12'], ['2022', '18'], ['2023', '15'], ['2024', '24'], ['2025', '29']]
							tr
								th= row[0]
								td= row[1]

	+section("Grow")
		p Add #[code data-chart-animate="grow"] to the figure. The area grows from zero instead of from left to right. The points move with it, and the numbers appear when it is done.

		+chart(null, '1')
			figure(data-chart="area" data-chart-shape="smooth" data-chart-animate="grow")
				figcaption
					b Visitors to the orchard
					br
					span thousands
				table
					tbody
						each row in [['2021', '12'], ['2022', '18'], ['2023', '15'], ['2024', '24'], ['2025', '29']]
							tr
								th= row[0]
								td= row[1]

		p To make every line and area grow, set the #[code animate] option to #[code "grow"]. A chart with triggered steps (like from Reveal.js fragments) still builds from left to right. See #[a(href=url('/styling/animation.html')) Animation].

	+section("Below zero")
		p Below zero, the area hangs down from the zero line, and a number is shown under its point.

		+chart(null, '7-8,10')
			figure(data-chart="area" data-chart-shape="smooth" data-chart-animate="grow")
				figcaption
					b Monthly result
					br
					span thousands of euros
				table
					tbody
						each row in [['Jan', '12.6'], ['Feb', '28.7'], ['Mar', '-11.7'], ['Apr', '-36.3'], ['May', '19.8'], ['Jun', '-4.1']]
							tr
								th= row[0]
								td= row[1]

	+section("Several areas")
		p Each value column is an area. The column header is the name of the area, shown at the end of its line. The areas overlap, so each one is see-through.

		+chart(null, '5')
			figure(data-chart="area")
				figcaption: b Apples per tree
				table
					thead
						tr
							th Year
							th North
							th South
					tbody
						each row in [['2016', '41', '30'], ['2019', '58', '39'], ['2022', '77', '52'], ['2025', '105', '61']]
							tr
								th= row[0]
								td= row[1]
								td= row[2]

		p The numbers work as in a #[a(href=url('/types/line.html')) line chart]. With two areas, the number of the lower point is below it. If there is no room for it above zero, it is above the point.

	+section("Highlight an area")
		p Add #[code data-kind="focus"] to the header of a column. That area keeps its colour and shows its numbers. The other areas are shown fainter.

		+chart(null, '4')
			figure(data-chart="area")
				table
					thead
						tr
							th Year
							th(data-kind="focus") North
							th South
							th East
					tbody
						each row in [['2016', '41', '30', '22'], ['2019', '58', '39', '35'], ['2022', '77', '52', '41'], ['2025', '105', '61', '70']]
							tr
								th= row[0]
								td= row[1]
								td= row[2]
								td= row[3]

	+section("Change the fill")
		p The fill has the colour of the line, at 25% opacity. To change it, set these variables.

		table
			thead
				tr
					th Variable
					th Sets
			tbody
				tr
					td: code --tablechart-area-opacity
					td The opacity of the fill. The default is #[code 0.25].
				tr
					td: code --tablechart-area-color
					td The colour of the fill. By default, the colour of the line.

		+chart(null, '1')
			figure(data-chart="area" style="--tablechart-area-opacity: 0.5")
				table
					tbody
						each row in [['2021', '12'], ['2022', '18'], ['2023', '15'], ['2024', '24'], ['2025', '29']]
							tr
								th= row[0]
								td= row[1]

	+section("Stacked areas")
		p Add #[code data-chart-stack] to the figure. Each area starts on top of the one before it, the first value column at the bottom. A value below zero takes its area down from the one before it. Each number is shown in the middle of its area, if there is room for it. If you point at the row, or tap it, a tooltip shows the numbers of that row.

		+chart(null, '1')
			figure(data-chart="area" data-chart-stack)
				figcaption
					b Apples sold
					br
					span thousands
				table
					thead
						tr
							th Year
							th Farm shop
							th Market
					tbody
						each row in [['2023', '64', '38'], ['2024', '71', '45'], ['2025', '69', '57'], ['2026', '80', '62']]
							tr
								th= row[0]
								td= row[1]
								td= row[2]

		p Stacked areas do not overlap, so their default opacity is #[code 0.5].
		p In a stack, each area adds its value to the one before it, also below zero. The top line is the total. A number of a part below zero is in the tooltip of its row, so it does not cover the number of the area under it.

		+chart
			figure(data-chart="area" data-chart-stack)
				figcaption
					b Monthly result
					br
					span thousands of euros
				table
					thead
						tr
							th Month
							th Shop
							th Market
					tbody
						each row in [['Jan', '12', '-4'], ['Feb', '8', '-9'], ['Mar', '-6', '3'], ['Apr', '-14', '-7'], ['May', '4', '-2'], ['Jun', '10', '5']]
							tr
								th= row[0]
								td= row[1]
								td= row[2]

	+section("Steps")
		p Add #[code data-chart-shape="step"] to the figure. Each value is flat across the width of its row, and the line goes straight up or down to the next row. A number is shown only where the value changes, in the middle of the rows that have that value. If a number is wider than those rows, it is left out. If you point at the row, or tap it, a tooltip shows the numbers of that row.

		+chart(null, '1')
			figure(data-chart="area" data-chart-stack data-chart-shape="step" data-chart-legend)
				figcaption
					b Land at the orchard
					br
					span share of the land, by kind of tree
				table
					thead
						tr
							th Year
							th Apple trees
							th Pear trees
					tbody
						each row in [['2014', 90], ['2015', 90], ['2016', 90], ['2017', 75], ['2018', 75], ['2019', 75], ['2020', 75], ['2021', 60], ['2022', 60], ['2023', 55], ['2024', 55], ['2025', 55]]
							tr
								th= row[0]
								td #{row[1]}%
								td #{100 - row[1]}%

	+section("Missing values")
		p If a cell has no number, such as #[code n/a], the area has a gap there.

		+chart(null, '6')
			figure(data-chart="area")
				table
					tbody
						each row in [['Jan', '88'], ['Feb', '74'], ['Mar', 'n/a'], ['Apr', '49'], ['May', '55']]
							tr
								th= row[0]
								td= row[1]

	+section("Axis and gridlines")
		p By default there is no value axis: the numbers on the points show the values. To add numbers along the axis, on the left, add #[code data-chart-axis]. To add a light line at each of those numbers, add #[code data-chart-grid]. You can add one of them, or both. To add them to every chart, set the #[code axis] and #[code grid] options to #[code true].

		+chart(null, '1')
			figure(data-chart="area" data-chart-axis data-chart-grid)
				figcaption
					b Visitors to the orchard
					br
					span thousands
				table
					tbody
						each row in [['2021', '12'], ['2022', '18'], ['2023', '15'], ['2024', '24'], ['2025', '29']]
							tr(data-kind=row[2])
								th= row[0]
								td= row[1]

		p If a chart has an axis or gridlines, its scale ends on a number of the axis. To set the scale yourself, add #[code data-chart-scale], such as #[code data-chart-scale="0 100"]. To change how the axis and gridlines look, see #[a(href=url('/styling/axes.html')) Axes and gridlines].

	+section("Next")
		p To show the names in a row under the chart, see #[a(href=url('/features/legends.html')) Legends].
