{
  "name": "@martinomagnifico/tablechart",
  "version": "1.2.2",
  "description": "Simple charts from an HTML or Markdown table: column, bar, line, area, waterfall, donut and scatter plot. Accessibility first.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/tablechart.mjs",
  "types": "./dist/tablechart.d.mts",
  "unpkg": "./dist/tablechart.js",
  "jsdelivr": "./dist/tablechart.js",
  "exports": {
    ".": {
      "types": "./dist/tablechart.d.mts",
      "import": "./dist/tablechart.mjs"
    },
    "./core": {
      "types": "./dist/tablechart-core.d.mts",
      "import": "./dist/tablechart-core.mjs"
    },
    "./additional-types": {
      "types": "./dist/tablechart-additional-types.d.mts",
      "import": "./dist/tablechart-additional-types.mjs"
    },
    "./summary": {
      "types": "./dist/tablechart-summary.d.mts",
      "import": "./dist/tablechart-summary.mjs"
    },
    "./style.css": "./dist/tablechart.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "start": "cd docs && npm start",
    "dev": "vite",
    "docs": "cd docs && npm start",
    "docs:build": "npm run check:variables && cd docs && npm run build",
    "check:variables": "node scripts/variables.mjs",
    "docs:preview": "npm run build && cd docs && rm -rf dist && npm run build && npm run preview",
    "preview": "npm run docs:preview",
    "prebuild": "node scripts/lock-version.mjs",
    "build": "npm run clean && npm run build:lib",
    "build:lib": "vite build",
    "size": "node scripts/size.mjs",
    "test": "npm run build && node test/speed.test.mjs",
    "test:layout": "node test/layout.test.mjs",
    "lab": "node lab/pdf/lab.mjs",
    "lab:pdf": "node lab/pdf/lab.mjs --pdf",
    "prepack": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "chart",
    "charts",
    "svg",
    "table",
    "waterfall",
    "donut"
  ],
  "author": "Martijn De Jongh",
  "license": "MIT",
  "devDependencies": {
    "@vituum/vite-plugin-pug": "^2.0.1",
    "liquidjs": "^10.30.0",
    "rolldown-plugin-dts": "^0.28.8",
    "sass": "^1.97.3",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vituum": "^2.0.1"
  },
  "module": "./dist/tablechart.mjs",
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "overrides": {
    "vite-plugin-static-copy": {
      "chokidar": "^4.0.3"
    }
  }
}
